# ---------------------------------------------------------------------------
# credentials.env.example
#
# Copy this file to a new file called   credentials.env   (same folder) and
# fill in the four values. The scripts read credentials.env when they start.
# credentials.env is ignored by git, so the real key never gets saved online.
#
# Ask Jude for these. The key should be READ-ONLY (it can list and read files
# and nothing else). A read-only key cannot delete anything, so it is safe to
# have on a laptop.
# ---------------------------------------------------------------------------

# The key id and the secret, from the B2 console (Application Keys).
B2_KEY_ID=paste_the_key_id_here
B2_APP_KEY=paste_the_secret_here

# The bucket that holds the fingerprints, and the web address of the storage.
# The endpoint looks like  https://s3.eu-central-003.backblazeb2.com
B2_BUCKET=paste_the_bucket_name_here
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Where things live inside the bucket. These are the pod's real folder names.
# You should not need to change them.
B2_PDQ_BLOB_PREFIX=NEVER_DELETE_movie_hash_source_of_truth/pdq/
B2_SHARDS_PREFIX=pdq_cache_flat_v2/shards/

# Read-only access to the pod's database, for 4_pull_wrong_pdq_clips.py only.
# It looks like  postgresql://user:password@host:5432/dbname   Ask Jude for the
# read-only user (the one from analytics/analyst_setup.sql). Leave it blank if
# you do not need that script.
DATABASE_URL_READONLY=
